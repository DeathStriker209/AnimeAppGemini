{
  "name": "anikoto-tv-fork",
  "productName": "AniKoto TV Fork",
  "version": "2.0.0",
  "description": "AniKoto TV Fork — Desktop anime player with stream extraction from Anikoto TV backend",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.anikototvfork.app",
    "productName": "AniKoto TV Fork",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "AniKotoTVFork.exe"
    }
  },
  "author": "AniKoto TV Fork"
}